# Скопируйте в .env и заполните реальными значениями.
# Copy to .env and fill in real values.
# server.js завершится с process.exit(1) (см. src/config.js), если обязательная
# переменная отсутствует.

# --- Обязательные / Required ---

# ID сообщества VK (без минуса), например 123456789
VK_GROUP_ID=

# Секретный ключ Callback API (Настройки сообщества -> Работа с API -> Callback API)
VK_SECRET_KEY=

# Строка подтверждения сервера (та же страница Callback API, поле "Строка подтверждения").
# ВАЖНО: без неё VK не подтвердит новый Callback-сервер — при type=confirmation нужно
# вернуть РОВНО эту строку, а не "ok" (см. server.js). Обязательна при первой настройке
# нового сообщества; для уже подтверждённого сообщества можно оставить пустой.
VK_CONFIRMATION_CODE=

# Сервисный ключ доступа сообщества (для users.get / likes.getList)
VK_SERVICE_KEY=

# Токен бота из @BotFather
TELEGRAM_BOT_TOKEN=

# ID чата/канала Telegram, куда пересылаются уведомления
TELEGRAM_CHAT_ID=

# Сервисный аккаунт Firebase — используется для логирования (коллекция bot_logs), персистентности
# состояния (документ bot_state/main) и счётчиков статистики (коллекция stats_daily), все в Firestore.
# Firebase Console -> Project settings -> Service accounts -> Generate new private key — скачает
# JSON-файл. Вставьте сюда его содержимое ЦЕЛИКОМ, одной строкой (см. docs/FIREBASE_SETUP.md).
# Держите в секрете — даёт полный административный доступ к проекту Firebase.
FIREBASE_SERVICE_ACCOUNT=

# --- Опциональные / Optional ---

# ID базы Firestore. По умолчанию "default" — так называется база в этом проекте (проверено на
# реальном ключе: getFirestore(app) без явного ID ищет специальную "(default)", которой тут нет,
# и падает). Если у вас классическая "(default)"-база (старый флоу автосоздания без выбора ID при
# создании) — задайте здесь "(default)". См. docs/FIREBASE_SETUP.md.
FIREBASE_FIRESTORE_DATABASE_ID=default

# Отдельный чат для дублирования "лидовых" событий (например, выход из группы)
LEAD_CHAT_ID=

# Чат для отладочных сообщений и ошибок
DEBUG_CHAT_ID=

# Отдельный чат для периодического дайджеста статистики (см. STATS_DIGEST_HOURS ниже).
# Если не задан, а задана тема STATS (TELEGRAM_TOPIC_STATS_ID/-и-команда /set_topic stats),
# статистика уходит в эту тему ОСНОВНОГО чата (TELEGRAM_CHAT_ID) — единая супергруппа.
STATS_CHAT_ID=

# ID пользователей Telegram с доступом к админ-командам, через запятую
ADMIN_USER_IDS=

# Версия бота, отображаемая в /version (по умолчанию берётся из package.json)
BOT_VERSION=

# Порт HTTP-сервера (по умолчанию 3000)
PORT=3000

# --- Темы (forum topics) единой супергруппы / статистика ---
# Если вместо отдельных чатов (LEAD_CHAT_ID/DEBUG_CHAT_ID/STATS_CHAT_ID) вы используете одну
# супергруппу Telegram с включёнными темами (Forum Topics), укажите здесь ID нужных тем —
# получить ID темы можно командой /topic_id, выполнив её прямо внутри этой темы. Роль без
# отдельного *_CHAT_ID и без темы отключена (как раньше, до этой фичи). Все значения также
# переопределяются в рантайме через /set_topic <роль> <id|here|off> — персистентны в Firestore
# (документ bot_state/main).
TELEGRAM_TOPIC_MAIN_ID=
TELEGRAM_TOPIC_LEAD_ID=
TELEGRAM_TOPIC_DEBUG_ID=
TELEGRAM_TOPIC_STATS_ID=

# Если задано — раз в N часов бот сам публикует дайджест статистики (см. /stats,
# src/lib/stats.js) в роль "stats". Без этой переменной дайджест не отправляется
# автоматически, но команда /stats всё равно доступна по запросу.
STATS_DIGEST_HOURS=
